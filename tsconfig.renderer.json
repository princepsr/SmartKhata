{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "composite": true,
        "outDir": "./dist/renderer",
        "typeRoots": [
            "./node_modules/@types"
        ],
        "lib": [
            "ES2020",
            "DOM",
            "DOM.Iterable"
        ],
        "jsx": "react-jsx",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "allowJs": true,
        "types": [
            "vite/client",
            "node"
        ],
        "declaration": true
    },
    "include": [
        "src/renderer/**/*.ts",
        "src/renderer/**/*.tsx",
        "src/renderer/**/*.json",
        "src/shared/**/*.ts",
        "src/shared/**/*.tsx"
    ],
    "exclude": [
        "src/main/**/*",
        "src/preload/**/*",
        "node_modules"
    ]
}