{
  "name": "smartkhata",
  "version": "1.0.0",
  "description": "Local-first Kirana POS application for Windows",
  "main": "dist/main/src/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"pnpm dev:renderer\" \"pnpm dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "rimraf dist/main && pnpm copy:migrations && pnpm exec tsc-watch --project tsconfig.main.json --onSuccess \"pnpm start:electron\"",
    "dev:app": "pnpm build:main && pnpm start:electron",
    "start:electron": "pnpm exec tsc-alias -p tsconfig.main.json && electron .",
    "build": "pnpm build:renderer && pnpm build:main",
    "build:renderer": "pnpm exec tsc --project tsconfig.renderer.json && vite build",
    "build:main": "rimraf dist/main && node scripts/prepare-env.js && pnpm exec tsc --project tsconfig.main.json && pnpm exec tsc-alias -p tsconfig.main.json && pnpm copy:migrations && pnpm exec javascript-obfuscator ./dist/main --output ./dist/main --compact true --self-defending true --string-array true --string-array-encoding base64 --string-array-threshold 0.75",
    "copy:migrations": "copyfiles -u 0 src/main/database/migrations/*.sql dist/main",
    "build:win": "pnpm build && electron-builder --win",
    "build:win:portable": "pnpm build && electron-builder --win portable",
    "preview": "vite preview",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "release": "node scripts/release.js",
    "release:check": "pnpm lint && pnpm type-check && pnpm test:run",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css,md}\"",
    "type-check": "npm run type-check:main && npm run type-check:renderer",
    "type-check:main": "tsc --project tsconfig.main.json --noEmit",
    "type-check:renderer": "tsc --project tsconfig.renderer.json --noEmit",
    "clean": "rimraf dist build out release",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "electron",
    "pos",
    "kirana",
    "billing",
    "inventory"
  ],
  "author": "SmartKhata Team",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/adm-zip": "^0.5.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^1.1.0",
    "@vitest/ui": "^1.1.0",
    "app-builder-bin": "^4.2.0",
    "concurrently": "^9.1.2",
    "copyfiles": "^2.4.1",
    "electron": "^34.0.0",
    "electron-builder": "^24.13.3",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "javascript-obfuscator": "^5.3.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "sql.js": "1.12.0",
    "tsc-alias": "^1.8.16",
    "tsc-watch": "^7.2.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.5",
    "vite-plugin-javascript-obfuscator": "^3.1.0",
    "vitest": "^1.1.0",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "better-sqlite3": "^12.6.2",
    "electron-updater": "^6.3.9",
    "i18next": "^25.8.14",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.5.6",
    "react-router-dom": "^7.13.0",
    "tesseract.js": "^5.1.1",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "build": {
    "appId": "com.smartkhata",
    "productName": "SmartKhata",
    "copyright": "Copyright © 2026 SmartKhata Team",
    "icon": "resources/icons/icon.ico",
    "artifactName": "SmartKhata_Setup_${version}.exe",
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "SmartKhata",
        "repo": "smartkhata"
      }
    ],
    "compression": "maximum",
    "npmRebuild": false,
    "afterPack": "scripts/cleanup-locales.js",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.ts",
      "!**/*.tsx",
      "!**/*.d.ts",
      "!**/*.md",
      "!**/tsconfig*.json",
      "!**/node_modules/**/*.map",
      "!**/node_modules/**/*.ts",
      "!**/node_modules/**/*.tsx",
      "!**/node_modules/**/*.d.ts",
      "!**/node_modules/**/*.md",
      "!**/node_modules/**/*.{c,h,cpp,o,obj,a,lib,log,yml,yaml,txt}",
      "!**/node_modules/*/CHANGELOG.md",
      "!**/node_modules/*/README.md",
      "!**/node_modules/*/README",
      "!**/node_modules/*/README.txt",
      "!**/node_modules/*/{test,tests,doc,docs,__tests__,examples,example,demo,demos}",
      "!**/node_modules/tesseract.js-core/tesseract-core-simd-lstm.wasm.js",
      "!**/node_modules/tesseract.js-core/tesseract-core-lstm.wasm.js",
      "!**/node_modules/tesseract.js-core/tesseract-core-simd.js",
      "!**/node_modules/tesseract.js-core/tesseract-core-lstm.js",
      "!**/node_modules/sql.js/dist/*.debug.js",
      "!**/node_modules/xlsx/dist/xlsx.full.min.js",
      "!**/node_modules/xlsx/dist/xlsx.mini.min.js",
      "!**/node_modules/better-sqlite3/deps/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icons/icon.ico",
      "sign": "scripts/sign-hook.cjs",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SmartKhata",
      "runAfterFinish": true,
      "installerIcon": "resources/icons/installer.ico",
      "uninstallerIcon": "resources/icons/uninstaller.ico",
      "allowElevation": true,
      "menuCategory": "SmartKhata"
    },
    "portable": {
      "artifactName": "SmartKhata_Portable_${version}.exe"
    }
  }
}
