{
  "name": "smartkhata",
  "version": "0.1.0",
  "description": "Local-first Kirana POS application for Windows",
  "main": "dist/main/src/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"pnpm dev:renderer\" \"pnpm dev:main\" \"pnpm dev:electron\"",
    "dev:renderer": "vite",
    "dev:main": "tsc --project tsconfig.main.json --watch --preserveWatchOutput && tsc-alias -p tsconfig.main.json --watch",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build": "pnpm build:renderer && pnpm build:main",
    "build:renderer": "tsc --project tsconfig.renderer.json && vite build",
    "build:main": "tsc --project tsconfig.main.json && tsc-alias -p tsconfig.main.json",
    "build:win": "pnpm build && electron-builder --win --x64",
    "build:win:portable": "pnpm build && electron-builder --win portable",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css,md}\"",
    "type-check": "tsc --noEmit",
    "type-check:main": "tsc --project tsconfig.main.json --noEmit",
    "type-check:renderer": "tsc --project tsconfig.renderer.json --noEmit",
    "clean": "rimraf dist build out release"
  },
  "keywords": [
    "electron",
    "pos",
    "kirana",
    "billing",
    "inventory"
  ],
  "author": "SmartKhata Team",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.13.0",
    "zustand": "^5.0.11"
  },
  "build": {
    "appId": "com.smartkhata.pos",
    "productName": "SmartKhata",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}