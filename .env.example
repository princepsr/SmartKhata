# ==============================================================================
# SmartKhata - Environment Configuration Example
# ==============================================================================
# This file serves as a template for your local .env file.
# Copy this file to .env and fill in the values for your development setup.
# ==============================================================================

# ------------------------------------------------------------------------------
# ☁️ GOOGLE CLOUD BACKUP (REQUIRED FOR CLOUD INTEGRATION)
# ------------------------------------------------------------------------------
# Create a project at https://console.cloud.google.com/
# Enable: Google Drive API, Google People API
# Create: OAuth 2.0 Client ID (Application Type: "Web Application")
# Redirect URI: http://localhost:8888/oauth2callback

# Your Google OAuth Client ID
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Your Google OAuth Client Secret
# GOOGLE_CLIENT_SECRET=your-client-secret

# ------------------------------------------------------------------------------
# 🛠️ DATABASE & SECURITY (OPTIONAL)
# ------------------------------------------------------------------------------

# Optional: Encryption key for the local SQLite database
# If set, the database will be encrypted using this key.
# DB_ENCRYPTION_KEY=your-secure-random-key-here

# ------------------------------------------------------------------------------
# 🖨️ PRINTER CONFIGURATION (OPTIONAL)
# ------------------------------------------------------------------------------

# Optional: Specific name of the printer for thermal printing
# If left blank, the system will use the default printer.
# PRINTER_NAME=ThermalPrinter

# ------------------------------------------------------------------------------
# 🧪 DEVELOPMENT & LOGGING (OPTIONAL)
# ------------------------------------------------------------------------------

# Optional: Set to 'true' to enable verbose logging for debugging
# DEBUG=true

# Optional: Port for the internal IPC/Auth callback server (Default: 3000)
# GOOGLE_REDIRECT_PORT=3000

# ------------------------------------------------------------------------------
# 📱 WHATSAPP BUSINESS API (META)
# ------------------------------------------------------------------------------
# Required for automated background daily reports.
# Create a Meta Developer app at https://developers.facebook.com/
# Add WhatsApp product and get the following from the Dashboard.

# Permanent Graph API Access Token
# WHATSAPP_META_TOKEN=your-long-lived-access-token

# Phone Number ID (from WhatsApp > Getting Started)
# WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
